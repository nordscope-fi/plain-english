{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/plain-english.mjs\" hook docs --agent codex",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/plain-english.mjs\" hook github --agent codex",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__linear__save_issue|mcp__linear__save_comment",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/plain-english.mjs\" hook issue --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/plain-english.mjs\" hook chat --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/plain-english.mjs\" hook chat --agent codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
