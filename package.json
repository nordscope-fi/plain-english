{
  "name": "plain-english",
  "version": "1.14.3",
  "description": "Catch AI writing tells and unexplained jargon before they land. Prose linter with native hooks for Claude Code, Copilot, Codex, Cursor, Vibe, Gemini CLI, Antigravity and Qwen Code.",
  "keywords": [
    "linter",
    "lint",
    "static-code-analysis",
    "writing",
    "prose",
    "markdown",
    "ai-detection",
    "ai-slop",
    "claude-code",
    "pre-commit",
    "style-guide",
    "readability",
    "technical-writing",
    "typescript",
    "copilot",
    "codex",
    "cursor",
    "vibe",
    "mistral",
    "gemini-cli",
    "antigravity",
    "qwen-code",
    "agents-md",
    "sarif",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "NordScope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nordscope-fi/plain-english.git"
  },
  "bugs": {
    "url": "https://github.com/nordscope-fi/plain-english/issues"
  },
  "homepage": "https://github.com/nordscope-fi/plain-english#readme",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "plain-english": "dist/cli.js",
    "plain-english-pre-commit": "integrations/claude-code-plugin/dist/cli.mjs"
  },
  "main": "dist/lint.js",
  "types": "dist/lint.d.ts",
  "typesVersions": {
    "*": {
      "source-prose": [
        "dist/source-prose.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    },
    "./package.json": "./package.json",
    "./source-prose": {
      "types": "./dist/source-prose.d.ts",
      "default": "./dist/source-prose.js"
    }
  },
  "files": [
    "dist",
    "rules",
    "integrations",
    "examples",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-plugin.mjs",
    "render": "node dist/cli.js render",
    "lint:self": "node dist/cli.js lint docs README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md AGENTS.md --fail-on error",
    "policy": "node dist/cli.js policy",
    "policy:check": "node dist/cli.js policy --check",
    "check:refs": "bash scripts/check-no-private-refs.sh",
    "check:refs:history": "bash scripts/check-no-private-refs.sh --history",
    "version": "node scripts/date-changelog.mjs",
    "pretest": "npm run check:refs && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check:refs && npm run check:refs:history && npm run build && npm test",
    "probe": "node scripts/probe-adapter.mjs",
    "posttest": "npm run probe"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "entities": "^7.0.1",
    "htmlparser2": "^10.1.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-nlcst": "^7.0.1",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "nlcst-to-string": "^4.0.0",
    "parse-english": "^7.0.0",
    "parse-latin": "^7.0.0",
    "retext-english": "^5.0.0",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
