{
  "name": "plain-english",
  "version": "0.1.1",
  "description": "Catch AI writing tells before they land. A linter for banned words and AI-tell sentence shapes, with adapters for Claude Code hooks, pre-commit, and CI.",
  "keywords": [
    "linter",
    "lint",
    "static-code-analysis",
    "writing",
    "prose",
    "markdown",
    "ai-detection",
    "ai-slop",
    "claude-code",
    "pre-commit",
    "style-guide",
    "typescript"
  ],
  "license": "MIT",
  "author": "NordScope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nordscope-fi/plain-english.git"
  },
  "bugs": {
    "url": "https://github.com/nordscope-fi/plain-english/issues"
  },
  "homepage": "https://github.com/nordscope-fi/plain-english#readme",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "plain-english": "dist/cli.js"
  },
  "main": "dist/lint.js",
  "types": "dist/lint.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "rules",
    "integrations",
    "examples",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "render": "node dist/cli.js render",
    "lint:self": "node dist/cli.js lint docs README.md",
    "check:refs": "bash scripts/check-no-private-refs.sh",
    "check:refs:history": "bash scripts/check-no-private-refs.sh --history",
    "pretest": "npm run check:refs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check:refs && npm run check:refs:history && npm run build && npm test"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
